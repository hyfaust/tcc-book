=== .text 节内容 (偏移 0x380, 101 字节) ===

; --- add() 函数 (偏移 0x00, 29 字节) ---
00000380  55                     push   rbp
00000381  48 89 e5               mov    rbp, rsp
00000384  48 81 ec 10 00 00 00   sub    rsp, 0x10
0000038b  48 89 7d f8            mov    [rbp-8], rdi        ; 参数 a
0000038f  48 89 75 f0            mov    [rbp-0x10], rsi     ; 参数 b
00000393  8b 45 f8               mov    eax, [rbp-8]
00000396  8b 4d f0               mov    ecx, [rbp-0x10]
00000399  01 c8                   add    eax, ecx
0000039b  c9                     leave
0000039c  c3                     ret

; --- main() 函数 (偏移 0x1d, 72 字节) ---
0000039d  55                     push   rbp
0000039e  48 89 e5               mov    rbp, rsp
000003a1  48 81 ec 10 00 00 00   sub    rsp, 0x10
000003a8  b8 08 00 00 00         mov    eax, 8
000003ad  48 89 c6               mov    rsi, rax            ; 第二个参数 = 8

; R_X86_64_GOTPCREL 重定位: global_var (偏移 0x3b0, 4 字节)
000003b0  48 8b 05 00 00 00 00   mov    rax, [rip+0]       ; 占位符，待链接器修补
                                                          ; 目标: 通过 GOT 加载 global_var
                                                          ; 修补后: mov rax, [rip + GOT_offset]

000003b7  8b 00                  mov    eax, [rax]

; R_X86_64_PLT32 重定位: add (偏移 0x3b9, 4 字节 — 标注中偏移 0x3bd 是 rip 指向)
000003b9  48 89 c7               mov    rdi, rax            ; 第一个参数 = global_var
000003bc  e8 00 00 00 00         call   0                   ; 占位符，待链接器修补
                                                          ; 目标: call add (通过 PLT 或直接调用)
                                                          ; 修补后: call add@plt 或 call add

000003c1  89 45 fc               mov    [rbp-4], eax        ; local = 返回值

000003c4  8b 45 fc               mov    eax, [rbp-4]

; R_X86_64_PC32 重定位: L.6 (格式字符串, 偏移 0x3c9)
000003c7  48 89 c6               mov    rsi, rax            ; printf 的第二个参数
000003ca  48 8d 05 00 00 00 00   lea    rax, [rip+0]       ; 占位符
                                                          ; 修补后: lea rax, [rip + offset_to_L.6]

000003d1  48 89 c7               mov    rdi, rax            ; printf 的第一个参数 = "hello: %d\n"
000003d4  b8 00 00 00 00         mov    eax, 0              ; 无浮点参数

; R_X86_64_PLT32 重定位: printf (偏移 0x3d9)
000003d9  e8 00 00 00 00         call   0                   ; 占位符
                                                          ; 修补后: call printf@plt

000003de  b8 00 00 00 00         mov    eax, 0              ; return 0
000003e3  c9                     leave
000003e4  c3                     ret

