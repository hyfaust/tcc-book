hello.o hexdump (x86-64, compiled with: tcc -c -o hello.o hello.c)

=== 源文件 ===

    #include <stdio.h>
    int global_var = 42;
    int add(int a, int b) { return a + b; }
    int main(void) {
        int local = add(global_var, 8);
        printf("hello: %d\n", local);
        return 0;
    }

